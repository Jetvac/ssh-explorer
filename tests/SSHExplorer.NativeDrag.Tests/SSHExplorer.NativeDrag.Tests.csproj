<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SSHExplorer.Core/SSHExplorer.Core.csproj" />
    <Compile Include="../../src/SSHExplorer.App/NativeDragDrop/*.cs" Link="NativeDragDrop/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
