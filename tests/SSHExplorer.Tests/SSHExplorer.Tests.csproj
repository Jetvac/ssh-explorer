<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SSHExplorer.Tests</AssemblyName>
    <IncludeCoreTests Condition="'$(IncludeCoreTests)' == ''">true</IncludeCoreTests>
    <DefineConstants Condition="'$(IncludeCoreTests)' == 'true'">$(DefineConstants);CORE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SSHExplorer.Monitoring/SSHExplorer.Monitoring.csproj" />
    <ProjectReference Include="../../src/SSHExplorer.Core/SSHExplorer.Core.csproj" Condition="'$(IncludeCoreTests)' == 'true'" />
  </ItemGroup>
</Project>
