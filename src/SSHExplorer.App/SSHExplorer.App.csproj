<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Remote desktop: the Windows RDP ActiveX control is hosted through WinForms AxHost in a WindowsFormsHost. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SSHExplorer</AssemblyName>
    <RootNamespace>SSHExplorer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The UI is Russian: keep only ru framework/WPF satellite resources (English is neutral, no folder). -->
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <!-- Package IntelliSense XML (WebView2 *.xml) is for developers, not for the portable bundle. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is used only by the RDP host: its names must not shadow WPF ones elsewhere. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SSHExplorer.Core\SSHExplorer.Core.csproj" />
    <ProjectReference Include="..\SSHExplorer.Monitoring\SSHExplorer.Monitoring.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Resource Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Terminal\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
